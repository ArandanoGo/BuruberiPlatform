{
  "ReverseProxy": {
    "Routes": {
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/inventory" }
        ]
      },
      "iam-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/iam/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/iam" }
        ]
      },
      "review-route": {
        "ClusterId": "review-cluster",
        "Match": {
          "Path": "/review/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/review" }
        ]
      },
      "communication-route": {
        "ClusterId": "communication-cluster",
        "Match": {
          "Path": "/communication/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/communication" }
        ]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/order/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/order" }
        ]
      }
    },
    "Clusters": {
      "inventory-cluster": {
        "Destinations": {
          "inventory-service": {
            "Address": "http://inventory-service:8080/"
          }
        }
      },
      "iam-cluster": {
        "Destinations": {
          "iam-service": {
            "Address": "http://iam-service:8080/"
          }
        }
      },
      "review-cluster": {
        "Destinations": {
          "review-service": {
            "Address": "http://review-service:8080/"
          }
        }
      },
      "communication-cluster": {
        "Destinations": {
          "communication-service": {
            "Address": "http://communication-service:8080/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-service": {
            "Address": "http://order-service:8080/"
          }
        }
      }
    }
  }
}
