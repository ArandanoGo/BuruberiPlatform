{
  "ReverseProxy": {
    "Routes": {
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory/{**catch-all}"
        }
      },
      "iam-route": {
        "ClusterId": "iam-cluster",
        "Match": {
          "Path": "/iam/{**catch-all}"
        }
      },
      "review-route": {
        "ClusterId": "review-cluster",
        "Match": {
          "Path": "/review/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "inventory-cluster": {
        "Destinations": {
          "inventory-service": {
            "Address": "http://inventory-service:8080/"
          }
        }
      },
      "iam-cluster": {
        "Destinations": {
          "iam-service": {
            "Address": "http://iam-service:8080/"
          }
        }
      },
      "review-cluster": {
        "Destinations": {
          "review-service": {
            "Address": "http://review-service:8080/"
          }
        }
      }
    }
  }
}
